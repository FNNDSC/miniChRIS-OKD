# miniChRIS-OKD configuration — every tunable of the harness in one place.
#
# This file is bash, sourced by scripts/lib/common.sh. Keep it
# assignments-only: no side effects, no logic.
#
# Every value uses VAR="${VAR:-default}", so overrides win in this order:
#   1. environment          one-off:     ACCESS_MODE=lan just okd-install
#   2. config.local.env     persistent per-host overrides (gitignored)
#   3. this file            committed defaults
#
# Derived values (ACCESS_IP, BASE_DOMAIN, API/console URLs, VM gateway) are
# computed in scripts/lib/common.sh — override the inputs, not the results.

# ---------------------------------------------------------------------------
# Pinned versions — bump deliberately; record each validated combination in
# docs/versions.md.
# ---------------------------------------------------------------------------
OKD_VERSION="${OKD_VERSION:-4.22.0-okd-scos.6}"
LOCAL_PATH_PROVISIONER_VERSION="${LOCAL_PATH_PROVISIONER_VERSION:-v0.0.31}"
# Phase 2 (issue #130):
CHRIS_CHART_VERSION="${CHRIS_CHART_VERSION:-1.0.8}"      # appVersion CUBE 6.11.0
CHRISOMATIC_IMAGE="${CHRISOMATIC_IMAGE:-ghcr.io/fnndsc/chrisomatic:1.0.0}"

# ---------------------------------------------------------------------------
# Cluster stability gate — how long every cluster operator must hold
# Available / not-Progressing / not-Degraded *simultaneously*, and how long to
# wait for that. Used by okd-postinstall (settle after the identity-provider
# patch re-rolls the oauth stack) and okd-verify (the cluster-operators check).
#
# Raise the timeout on hosts below the Minimum tier in docs/requirements.md:
# with few vCPUs the post-install re-roll can take well over 10 minutes to
# quiesce, and the check needs one contiguous stable window inside the budget.
# oc requires TIMEOUT > PERIOD.
# ---------------------------------------------------------------------------
CLUSTER_STABLE_PERIOD="${CLUSTER_STABLE_PERIOD:-30s}"
CLUSTER_STABLE_TIMEOUT="${CLUSTER_STABLE_TIMEOUT:-20m}"

# ---------------------------------------------------------------------------
# Access mode — how the cluster is reached (see docs/networking.md).
#   local : single developer on this box. Base domain derives from VM_IP;
#           no HAProxy, no firewall changes. DEFAULT.
#   lan   : remote/headless box driven from other machines. Base domain
#           derives from HOST_IP; HAProxy forwards 80/443/6443 into the VM.
# The base domain is baked into the cluster at install time — switching
# modes means `just okd-nuke && just okd-install`, not a config flip.
# ---------------------------------------------------------------------------
ACCESS_MODE="${ACCESS_MODE:-local}"

# Host LAN IP (lan mode). Auto-detected from the default route when unset.
HOST_IP="${HOST_IP:-}"

# Cluster identity: api.<CLUSTER_NAME>.<BASE_DOMAIN>, *.apps.<CLUSTER_NAME>.<BASE_DOMAIN>
CLUSTER_NAME="${CLUSTER_NAME:-okd}"
# Base domain. Default derives from the access IP: <ACCESS_IP>.sslip.io
BASE_DOMAIN="${BASE_DOMAIN:-}"

# ---------------------------------------------------------------------------
# VM sizing — defaults fit the "comfortable" tier (docs/requirements.md).
# ---------------------------------------------------------------------------
VM_NAME="${VM_NAME:-okd-sno}"
VM_VCPUS="${VM_VCPUS:-10}"
VM_RAM_MIB="${VM_RAM_MIB:-32768}"
VM_DISK_GB="${VM_DISK_GB:-200}"
# libosinfo OS variant for virt-install; falls back to 'generic' if unknown.
VM_OS_VARIANT="${VM_OS_VARIANT:-centos-stream10}"

# ---------------------------------------------------------------------------
# VM network — a dedicated libvirt NAT network with a static DHCP
# reservation (VM_MAC -> VM_IP). Must be a /24.
# ---------------------------------------------------------------------------
VM_NET_NAME="${VM_NET_NAME:-okd-net}"
VM_NET_CIDR="${VM_NET_CIDR:-192.168.126.0/24}"
VM_IP="${VM_IP:-192.168.126.10}"
VM_MAC="${VM_MAC:-52:54:00:0c:8d:01}"

# Where VM disk images live — put this on your big volume.
# Default (set in common.sh): okd/state/images inside this repo.
IMAGES_DIR="${IMAGES_DIR:-}"

# SSH public key baked into the node for `ssh core@<VM_IP>` debugging.
# Default: a dedicated keypair generated under okd/state/ssh/.
SSH_PUB_KEY_FILE="${SSH_PUB_KEY_FILE:-}"

# ---------------------------------------------------------------------------
# Phase 2 (issue #130) — see scripts/lib/chris.sh for the derived values
# (CUBE URLs, chart secret names).
# ---------------------------------------------------------------------------
CHRIS_NAMESPACE="${CHRIS_NAMESPACE:-chris}"
# Helm release name. Must contain "chris" (chart resource names collapse to
# the release name only in that case; scripts/lib/chris.sh enforces it).
CHRIS_RELEASE="${CHRIS_RELEASE:-chris}"
# Non-admin account the smoke test (Phase 3) logs in as; created by
# 'just chris-seed', password generated once into okd/state/auth/.
CHRIS_TEST_USER="${CHRIS_TEST_USER:-smoke}"

# ---------------------------------------------------------------------------
# Phase 3 (issue #131) — functional smoke test budgets. scripts/smoke.sh
# wires everything else (URL, credentials, router CA, kubeconfig) from
# harness state; see smoke/README.md for the full env/flag surface.
# ---------------------------------------------------------------------------
# Overall budget (seconds) for both plugin instances to finish.
SMOKE_TIMEOUT="${SMOKE_TIMEOUT:-600}"
# Instance status poll cadence (seconds).
SMOKE_POLL_INTERVAL="${SMOKE_POLL_INTERVAL:-5}"
